---
import Base from "@/layouts/Base.astro";
import VideoShowcase from "@/layouts/components/VideoShowcase.astro";
import { site } from "@/data/site";
import { reels } from "@/data/reels";

const expertise = [
  ["Video Editing", "Clean cuts, engaging pacing, seamless transitions, compelling storytelling and polished final delivery designed around the purpose of each video."],
  ["Motion Graphics", "Custom animated graphics, dynamic typography, 2D and 3D elements, UI animations and visual explanations."],
  ["Visual Effects (VFX)", "Creative compositing, masking, tracking, object integration and visual enhancements that add depth and production value."],
  ["AI-Powered Video Creation", "AI-assisted visual generation, creative concepts, cinematic scenes and supporting assets."],
  ["Cinematic Editing & Color Grading", "Atmospheric visuals, refined color tones, thoughtful pacing and cinematic treatments."],
  ["Sound Design", "Carefully selected music, sound effects, audio transitions and impactful sound layering."],
  ["Social Media & Brand Content", "Platform-focused videos designed for Reels, Shorts, advertisements, campaigns and digital brands."],
];
const industries = [
  ["Real Estate & Property Films", "Premium property promotions, cinematic walkthroughs, project highlights and location showcases."],
  ["Finance & Trading Videos", "Trading explainers, financial education content, animated charts, platform showcases and promotional videos."],
  ["Technology & SaaS Videos", "Product explainers, software demonstrations, interface animations and feature highlights."],
  ["Premium Brand Advertisements", "High-quality promotional edits, product-focused visuals and branded storytelling."],
  ["Cinematic & Creative Edits", "Mood-driven editing, cinematic sequences, visual storytelling, sound design and crafted transitions."],
  ["Social Media & Performance Creatives", "Attention-grabbing short-form content, promotional Reels and campaign videos."],
];
const why = [
  ["Creative Approach", "I focus on understanding the idea behind a project and finding a visual style that supports its message and audience."],
  ["Attention to Detail", "From timing and transitions to typography, sound and visual consistency, I care about the details that make an edit feel complete."],
  ["Industry Versatility", "Experience across multiple content styles helps me adapt my editing approach to different brands, industries and creative requirements."],
  ["Modern Editing Techniques", "I combine editing fundamentals with motion graphics, VFX, compositing and AI-assisted workflows when they add value to the project."],
  ["Brand-Focused Execution", "The objective is not just to make a video look good. It is to create content that fits the brand's identity and communicates its message clearly."],
  ["Professional Collaboration", "Clear communication, an understanding of project requirements and an organized workflow help keep the creative process focused from brief to delivery."],
];
const process = [["01", "Discover", "We discuss your brand, target audience, project goals, references and the message your video needs to communicate."], ["02", "Plan", "I identify the editing style, pacing, visual direction, motion graphics and supporting elements suited to the project."], ["03", "Create", "The editing process brings everything together through storytelling, motion design, sound, compositing and visual refinement."], ["04", "Refine", "The video is reviewed against the agreed creative direction, with revisions handled according to the project scope."], ["05", "Deliver", "The final video is exported in the agreed format and specifications, ready for its intended platform."]];
const clients = [["Nexthop_Ecorner", "https://www.instagram.com/nexthop_ecorner"], ["Veer Estate Infra", "https://www.instagram.com/veerestateinfra"], ["NB Realtors", "https://www.instagram.com/nbre.altors"], ["Naughty Rituals", "https://www.instagram.com/naughtyrituals.in"], ["Peppy For All", "https://www.instagram.com/peppyforall"], ["Tulip Financial Services", "https://www.instagram.com/tulipfinancialservicesltd"], ["Thrillerrr", "https://www.instagram.com/thrillerrr.in"]];
const categories = ["Premium Commercials & Advertisements", "Real Estate & Property Films", "Finance & Trading", "Technology & SaaS", "Motion Graphics & UI Animation", "VFX & Compositing", "AI-Assisted Visuals", "Cinematic Edits & Social Media Reels"];
---
<Base title="Anmol Sharma | Video Editor & Motion Graphics Artist" description="Video editing, motion graphics and visual storytelling by Anmol Sharma.">
  <section id="home" class="section-ph hero"><div class="container"><div class="hero-copy text-center"><p class="eyebrow">{site.name}</p><h1>Turning Ideas Into <strong>Visual Experiences.</strong></h1><p class="hero-role">{site.tagline}</p><p class="hero-copy-text">I create high-quality, engaging and visually compelling videos that help brands communicate better, capture attention and stand out in a crowded digital world.</p><p class="hero-copy-text">From cinematic storytelling and premium promotional videos to advanced motion graphics, VFX and AI-powered visuals, I bring creative ideas to life through purposeful editing and impactful visual design.</p><div class="hero-actions"><a class="btn btn-primary" href="#work">Explore My Work</a><a class="btn btn-outline" href="#contact">Let's Work Together</a></div><p class="hero-badge">2+ Years of Video Editing Experience</p><p class="hero-tagline">Every frame has a purpose. Every edit tells a story.</p></div><div class="hero-video-gap"><VideoShowcase /></div></div></section>

  <section id="about" class="section content-section"><div class="container"><p class="eyebrow text-center">The Person Behind the Edits</p><div class="section-intro centralize"><h2 class="title">More Than Editing. <strong>It's About Creating an Impact.</strong></h2></div><div class="prose narrow"><p>Hi, I'm Anmol Sharma, a video editor and motion graphics artist with 2+ years of experience creating engaging visual content across multiple industries and content formats.</p><p>My approach to video editing goes beyond simply cutting clips together. I focus on storytelling, pacing, sound design, visual aesthetics, motion graphics and the small details that transform an ordinary video into a memorable experience.</p><p>Over the past two years, I've developed experience working on different styles of content for brands and projects, including real estate, finance and trading, technology, promotional campaigns, cinematic edits and social media content.</p><p>I also work with visual effects, AI-assisted video creation and advanced motion graphics to explore creative possibilities and deliver visuals that match the project's goals.</p><p>For me, great editing is the perfect balance of creativity, clarity and purpose. Whether the objective is to build brand credibility, explain a complex concept or capture an audience's attention, every decision should contribute to the final result.</p><p class="highlight">My goal is simple: to help brands turn their ideas into videos people want to watch, remember and act on.</p></div></div></section>

  <section id="expertise" class="section content-section"><div class="container"><p class="eyebrow text-center">What I Bring to Every Project</p><div class="section-intro centralize"><h2 class="title">Creative Thinking. <strong>Technical Precision. Powerful Visuals.</strong></h2></div><div class="card-grid seven">{expertise.map(([title, text], i) => <article class="info-card"><span class="card-number">0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section id="industries" class="section content-section tinted"><div class="container"><div class="section-intro centralize"><h2 class="title">Different Industries. <strong>Different Stories. One Creative Approach.</strong></h2></div><div class="card-grid six">{industries.map(([title, text]) => <article class="info-card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section id="work" class="section content-section"><div class="container"><p class="eyebrow text-center">The Best Way to Understand My Editing</p><div class="section-intro centralize"><h2 class="title">Don't Just Take My Word for It. <strong>Watch the Work.</strong></h2><p class="subtitle">Every project comes with a different story, audience and creative challenge. My focus is to find the right visual approach for each one.</p></div><div class="chips">{categories.map((category) => <span>{category}</span>)}</div><div class="reels-grid home-reels">{reels.map((reel) => <article class="reel-card"><div class="reel-frame"><video preload="metadata" playsinline aria-label={reel.title}><source src={reel.file} /></video><button class="reel-play" type="button" aria-label={`Play ${reel.title}`}>▶</button></div></article>)}</div></div></section>

  <section id="why" class="section content-section tinted"><div class="container"><div class="section-intro centralize"><h2 class="title">Your Vision Deserves <strong>More Than an Ordinary Edit.</strong></h2></div><div class="card-grid six">{why.map(([title, text]) => <article class="info-card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section id="process" class="section content-section"><div class="container"><div class="section-intro centralize"><h2 class="title">From Your Idea <strong>to the Final Frame.</strong></h2></div><div class="process-list">{process.map(([number, title, text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div><p class="center-note">Good results come from a clear vision, thoughtful execution and attention to every detail.</p></div></section>

  <section id="philosophy" class="section philosophy"><div class="container narrow center"><p class="eyebrow">My Creative Philosophy</p><h2 class="title">Make Every <strong>Second Count.</strong></h2><p>Attention is valuable. Every second of a video should have a reason to exist.</p><p>I believe the strongest edits are not necessarily the ones with the most effects or the fastest transitions. They are the ones that understand the audience, communicate clearly and leave a lasting impression.</p><p>Sometimes that means a cinematic sequence. Sometimes it means a clean interface animation. And sometimes, the most powerful choice is to keep things simple.</p><p class="highlight">My philosophy is to make every frame intentional, every transition meaningful and every project worth watching.</p></div></section>

  <section id="clients" class="section content-section"><div class="container"><div class="section-intro centralize"><h2 class="title">Our <strong>Clients.</strong></h2></div><div class="clients-grid">{clients.map(([name, link]) => <a href={link} target="_blank" rel="noopener" class="client-card"><span>{name}</span><b class="instagram-link"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg> Instagram ↗</b></a>)}</div></div></section>

  <section id="contact" class="section content-section contact"><div class="container narrow center"><p class="eyebrow">Let's Create Something That Stands Out</p><h2 class="title">Have an Idea? <strong>Let's Bring It to Life.</strong></h2><p>Whether you're building a brand, promoting a property, launching a product or creating content for social media, I can help you shape your vision into a polished visual experience.</p><p>Tell me what you're working on, what you want to communicate and what success looks like for your project. Let's explore the right creative direction together.</p><p class="highlight">Your next great video starts with a conversation.</p><div class="hero-actions"><a class="btn btn-primary" href={site.whatsappLink}>Start Your Project</a><a class="btn btn-outline" href={`mailto:${site.email}`}>Contact Me</a></div><p>{site.whatsapp} · <a href={site.instagram}>{site.instagramHandle}</a> · {site.email}</p></div></section>
</Base>

<script>
  document.querySelectorAll(".reel-frame").forEach((frame) => {
    const video = frame.querySelector("video"); const btn = frame.querySelector(".reel-play"); if (!video || !btn) return;
    const show = () => btn.classList.remove("is-hidden"); const play = () => { document.querySelectorAll<HTMLVideoElement>(".reel-frame video").forEach((v) => { if (v !== video) v.pause(); }); video.play(); };
    btn.addEventListener("click", play); video.addEventListener("click", () => video.paused ? play() : video.pause()); video.addEventListener("play", () => btn.classList.add("is-hidden")); video.addEventListener("pause", show); video.addEventListener("ended", show);
  });
</script>

<style>
  .hero{padding-top:160px}.hero-copy{max-width:900px;margin:auto}.eyebrow{color:var(--color-primary-light);font-size:12px;letter-spacing:.12em;text-transform:uppercase}.hero h1{font-size:clamp(3rem,6vw,6.5rem);line-height:1;margin:1.5rem 0}.hero h1 strong,.title strong{color:var(--color-primary-light)}.hero-role{font-size:1.2rem}.hero-copy-text{max-width:720px;margin:1rem auto;line-height:1.7}.hero-actions{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;margin:2rem 0}.hero-badge{font-weight:700}.hero-tagline{font-style:italic;color:var(--color-primary-light)}.hero-video-gap{margin-top:5rem}.content-section{padding-top:7rem;padding-bottom:7rem}.tinted{background:color-mix(in srgb,var(--color-primary) 6%,var(--color-body))}.narrow{max-width:760px;margin:2.5rem auto}.prose{line-height:1.8}.center{text-align:center}.highlight{color:var(--color-primary-light);font-weight:700}.card-grid{display:grid;gap:1.25rem;margin-top:3.5rem}.card-grid.seven{grid-template-columns:repeat(4,1fr)}.card-grid.six{grid-template-columns:repeat(3,1fr)}.info-card{position:relative;isolation:isolate;overflow:hidden;display:flex;flex-direction:column;padding:1.75rem;border:1px solid color-mix(in srgb,var(--color-primary-light) 28%,transparent);border-radius:1.5rem;background:linear-gradient(145deg,color-mix(in srgb,var(--color-primary) 16%,var(--color-body)),color-mix(in srgb,var(--color-light) 24%,var(--color-body)) 48%,color-mix(in srgb,var(--color-body) 94%,#000));box-shadow:0 18px 45px #0004,inset 0 1px #ffffff12;min-height:310px;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}.info-card::before{content:"";position:absolute;z-index:-1;top:-90px;right:-70px;width:190px;height:190px;border-radius:50%;background:var(--color-primary);opacity:.2;filter:blur(35px)}.info-card:hover{transform:translateY(-8px);border-color:var(--color-primary-light);box-shadow:0 24px 55px #0008,0 0 28px color-mix(in srgb,var(--color-primary) 28%,transparent)}.info-card .card-number{display:grid;place-items:center;width:44px;height:30px;border:1px solid color-mix(in srgb,var(--color-primary-light) 45%,transparent);border-radius:999px;background:color-mix(in srgb,var(--color-primary) 20%,transparent);color:#c9bfff;font-size:.8rem;font-weight:700}.info-card h3{margin:2.2rem 0 .9rem;color:#fff;font-size:clamp(1.65rem,2.2vw,2.35rem);line-height:1.08;letter-spacing:-.03em}.info-card p{margin-top:auto;font-size:.96rem;line-height:1.7;color:color-mix(in srgb,var(--color-text) 90%,#fff)}.chips{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin:2rem 0}.chips span{border:1px solid color-mix(in srgb,var(--color-text) 22%,transparent);border-radius:999px;padding:.55rem .8rem;font-size:.75rem}.home-reels{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:1.25rem;max-width:1180px;margin:3rem auto}.home-reels .reel-card{max-width:200px;width:100%;margin:auto}.reel-frame{position:relative;overflow:hidden;aspect-ratio:9/16;border-radius:1.1rem;background:#09090d}.reel-frame video{width:100%;height:100%;object-fit:cover;display:block;cursor:pointer}.reel-play{position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-50%);z-index:2;border:0;border-radius:999px;width:58px;height:58px;background:var(--color-primary);color:#fff;cursor:pointer}.reel-play.is-hidden{display:none}.center-note{text-align:center;max-width:650px;margin:2rem auto;line-height:1.7}.portfolio-button{display:block;width:max-content;margin:1rem auto}.process-list{max-width:900px;margin:3rem auto}.process-list article{display:grid;grid-template-columns:70px 180px 1fr;gap:1rem;align-items:start;padding:1.5rem 0;border-top:1px solid color-mix(in srgb,var(--color-text) 18%,transparent)}.process-list span{color:var(--color-primary-light);font-weight:700}.process-list h3{margin:0}.process-list p{margin:0;line-height:1.6}.philosophy{background:var(--color-primary);text-align:center}.philosophy .eyebrow,.philosophy .highlight{color:#fff}.clients-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:3rem}.client-card{display:flex;flex-direction:column;gap:1rem;padding:1.5rem;border:1px solid color-mix(in srgb,var(--color-text) 18%,transparent);border-radius:1rem}.client-card b{font-size:.75rem;color:var(--color-primary-light)}.contact{background:color-mix(in srgb,var(--color-primary) 8%,var(--color-body))}@media(max-width:900px){.card-grid.seven,.card-grid.six{grid-template-columns:repeat(2,1fr)}.clients-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.hero{padding-top:120px}.card-grid.seven,.card-grid.six,.clients-grid{grid-template-columns:1fr}.process-list article{grid-template-columns:45px 1fr}.process-list p{grid-column:2}.content-section{padding-top:5rem;padding-bottom:5rem}}
  .process-list{position:relative;max-width:1080px;margin:4rem auto 0;padding:1rem 0}.process-list::before{content:"";position:absolute;left:34px;top:25px;bottom:25px;width:2px;background:linear-gradient(var(--color-primary-light),color-mix(in srgb,var(--color-primary-light) 15%,transparent));box-shadow:0 0 18px color-mix(in srgb,var(--color-primary) 70%,transparent)}.process-list article{position:relative;display:grid;grid-template-columns:70px 220px 1fr;gap:1.5rem;align-items:center;margin:0 0 1.25rem;padding:1.6rem 1.8rem 1.6rem 0;border:1px solid color-mix(in srgb,var(--color-primary-light) 25%,transparent);border-radius:1.35rem;background:linear-gradient(100deg,color-mix(in srgb,var(--color-primary) 14%,var(--color-body)),color-mix(in srgb,var(--color-light) 18%,var(--color-body)));box-shadow:0 14px 35px #0004,inset 0 1px #ffffff0d;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}.process-list article:hover{transform:translateX(8px);border-color:var(--color-primary-light);box-shadow:0 18px 42px #0007,0 0 25px color-mix(in srgb,var(--color-primary) 25%,transparent)}.process-list article span{position:relative;z-index:1;display:grid;place-items:center;width:68px;height:68px;margin-left:0;border:4px solid var(--color-body);border-radius:50%;background:linear-gradient(145deg,var(--color-primary-light),var(--color-primary));color:#fff;font-size:1rem;font-weight:800;box-shadow:0 0 0 1px color-mix(in srgb,var(--color-primary-light) 60%,transparent),0 0 22px color-mix(in srgb,var(--color-primary) 60%,transparent)}.process-list article h3{margin:0;color:#fff;font-size:clamp(1.6rem,2.5vw,2.4rem);letter-spacing:-.03em}.process-list article p{margin:0;line-height:1.65;color:color-mix(in srgb,var(--color-text) 92%,#fff)}@media(max-width:900px){.process-list article{grid-template-columns:70px 1fr}.process-list article p{grid-column:2}.process-list article h3{align-self:end}}@media(max-width:600px){.process-list{margin-top:3rem;padding-left:0}.process-list::before{left:25px}.process-list article{grid-template-columns:52px 1fr;gap:1rem;padding:1.25rem 1rem 1.25rem 0}.process-list article span{width:52px;height:52px;font-size:.8rem}.process-list article h3{font-size:1.65rem}.process-list article p{grid-column:2;font-size:.9rem}}
  .philosophy{position:relative;overflow:hidden;background:radial-gradient(circle at 50% 0%,#43239a 0%,#17102f 42%,#070611 100%);border-top:1px solid #8c6dff55;border-bottom:1px solid #8c6dff55}.philosophy::before,.philosophy::after{content:"";position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none}.philosophy::before{width:360px;height:360px;left:-140px;top:20%;background:#653cff55}.philosophy::after{width:420px;height:420px;right:-160px;bottom:-30%;background:#b12cff3d}.philosophy .container{position:relative;z-index:1;max-width:1100px;padding:5rem 4rem;border:1px solid #a68bff42;border-radius:2rem;background:linear-gradient(135deg,#ffffff0d,#ffffff03);box-shadow:0 25px 80px #0008,inset 0 1px #ffffff18}.philosophy .eyebrow{color:#c9baff;font-weight:700}.philosophy .title{color:#fff;margin:1.1rem 0 1.5rem}.philosophy .title strong{color:#a990ff}.philosophy p{color:#e8e2ff;line-height:1.8;max-width:900px;margin:1rem auto}.philosophy .highlight{display:inline-block;margin-top:1.5rem;padding:.9rem 1.4rem;border:1px solid #a990ff66;border-radius:999px;background:#8c6dff18;color:#fff;font-weight:800;box-shadow:0 0 25px #8c6dff22}@media(max-width:600px){.philosophy .container{padding:3rem 1.25rem;border-radius:1.25rem}.philosophy .highlight{border-radius:1rem}}
  .clients-grid{max-width:1120px;margin:3.5rem auto 0;display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}.client-card{position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:center;justify-content:space-between;min-height:220px;padding:1.5rem;border:1px solid #a990ff35;border-radius:1.5rem;background:linear-gradient(145deg,#181332,#0a0915 70%);box-shadow:0 18px 40px #0005,inset 0 1px #ffffff12;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}.client-card::before{content:"";position:absolute;z-index:-1;width:150px;height:150px;right:-45px;bottom:-55px;border-radius:50%;background:#6947ff55;filter:blur(22px)}.client-card:hover{transform:translateY(-8px);border-color:#a990ff;box-shadow:0 24px 50px #0008,0 0 26px #6947ff35}.client-card span{align-self:flex-start;color:#fff;font-size:1rem;font-weight:700;line-height:1.3}.client-card b{display:flex;flex-direction:column;align-items:center;gap:.8rem;margin-top:1.8rem;color:#b8a5ff;font-size:.75rem;font-weight:600}.client-card svg{width:84px;height:84px;color:#987cff;filter:drop-shadow(0 0 14px #6947ff88)}@media(max-width:900px){.clients-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.clients-grid{grid-template-columns:1fr;gap:1rem}.client-card{min-height:190px}}
  .clients-grid{max-width:1000px;margin:2.5rem auto 0;gap:1rem}.client-card{min-height:175px;padding:1.15rem;border-radius:1.25rem}.client-card span{font-size:.85rem}.client-card b{gap:.55rem;margin-top:1rem;font-size:.68rem}.client-card svg{width:62px;height:62px}.client-card::before{width:110px;height:110px;right:-35px;bottom:-45px}@media(max-width:600px){.clients-grid{gap:.85rem}.client-card{min-height:160px;padding:1rem}}
  .philosophy .container{max-width:880px;padding:3rem 2.5rem}.philosophy .title{font-size:clamp(2rem,3.5vw,3.2rem);margin:.75rem 0 1rem}.philosophy p{font-size:.9rem;line-height:1.6;margin:.7rem auto}.philosophy .highlight{margin-top:1rem;padding:.7rem 1.1rem;font-size:.85rem}@media(max-width:600px){.philosophy .container{padding:2.25rem 1.1rem}.philosophy p{font-size:.85rem}}
  .info-card::after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(145deg,#080713cc,#080713f2),url('/hero-anmol.jpg') center/cover no-repeat;opacity:.34;mix-blend-mode:screen}.info-card:hover::after{opacity:.5}.info-card{background:linear-gradient(145deg,#21174dcc,#080713e8 70%)}
  #process{padding-top:10rem}.process-list::before{left:62px}.process-list article{padding-left:1.75rem}.process-list article span{margin-left:0}@media(max-width:600px){#process{padding-top:7rem}.process-list::before{left:25px}.process-list article{padding-left:1rem}}
  #clients{position:relative;overflow:hidden;background:radial-gradient(circle at 50% 0%,#2b176355,transparent 52%)}#clients .section-intro{margin-bottom:1rem}#clients .title{font-size:clamp(2.2rem,4vw,3.6rem);letter-spacing:-.04em}#clients .clients-grid{width:calc(100% - 2rem);max-width:980px;grid-template-columns:repeat(4,minmax(0,1fr));margin:2.25rem auto 0;gap:.9rem}.client-card{min-width:0;min-height:112px;padding:1rem 1.1rem;flex-direction:row;align-items:center;justify-content:space-between;border-radius:1.15rem;background:linear-gradient(120deg,#211a40,#0d0b19 72%);box-shadow:0 12px 25px #0005,inset 0 1px #ffffff12}.client-card span{max-width:58%;font-size:.82rem;white-space:normal;overflow:visible}.client-card b{flex-direction:column;gap:.35rem;margin:0;font-size:.62rem}.client-card svg{width:46px;height:46px}.client-card:nth-child(7){grid-column:auto}@media(max-width:900px){#clients .clients-grid{grid-template-columns:repeat(2,minmax(0,1fr));max-width:620px}}@media(max-width:600px){#clients .clients-grid{grid-template-columns:1fr;max-width:360px;width:calc(100% - 2rem)}.client-card{min-height:92px}}
  #about .prose.narrow{max-width:1000px;text-align:left}#about .prose p{margin:1.4rem 0;line-height:1.85}
</style>
